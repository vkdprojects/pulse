        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "value_and_name"
      },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 116,
      "type": "stat",
      "title": "Load 1m / por CPU",
      "gridPos": { "x": 20, "y": 4, "w": 4, "h": 4 },
      "datasource": "TimescaleDB",
