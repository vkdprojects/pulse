          "format": "time_series"
        },
        {
          "rawSql": "SELECT time, agent_id || '/' || name || ' temp°C' AS metric, temp_c AS value FROM gpu_metrics WHERE agent_id ~ '${agent:regex}' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
