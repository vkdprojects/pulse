          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "#EAB839", "value": 0.7 },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 1.5 }
            ]
          }
