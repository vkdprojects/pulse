    {
      "id": 164,
      "type": "table",
      "title": "Top Processos (último snapshot)",
      "gridPos": { "x": 0, "y": 51, "w": 24, "h": 6 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT p.agent_id, p.pid, p.name, p.cpu_bp / 100.0 AS cpu_pct, p.rss_bytes / 1048576 AS rss_mb FROM process_metrics p INNER JOIN (SELECT agent_id, max(time) AS t FROM process_metrics WHERE agent_id ~ '${agent:regex}' GROUP BY agent_id) latest ON p.agent_id = latest.agent_id AND p.time = latest.t WHERE p.agent_id ~ '${agent:regex}' ORDER BY p.rss_bytes DESC LIMIT 20",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "displayMode": "auto", "filterable": true } }
      },
      "options": { "showHeader": true, "footer": { "show": false } }
