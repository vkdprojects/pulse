        {
          "rawSql": "SELECT (cgroup_usage::float / NULLIF(cgroup_limit,0) * 100) AS value FROM metrics WHERE agent_id ~ '${agent:regex}' AND cgroup_limit > 0 ORDER BY time DESC LIMIT 1",
