    {
      "id": 117,
      "type": "bargauge",
      "title": "CPU por núcleo (%)",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT 'core ' || lpad((idx-1)::text, 2, '0') AS metric, c / 100.0 AS value FROM (SELECT unnest(cpu_cores_bp) AS c, generate_subscripts(cpu_cores_bp, 1) AS idx FROM metrics WHERE agent_id ~ '${agent:regex}' ORDER BY time DESC LIMIT 1) t ORDER BY idx",
          "format": "table"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "value" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "#EAB839", "value": 70 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        }
      }
    },

    {
      "id": 120,
      "type": "timeseries",
      "title": "CPU (total + por core)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT time, agent_id || ' total' AS metric, cpu_total_bp / 100.0 AS value FROM metrics WHERE agent_id ~ '${agent:regex}' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT time, agent_id || ' core ' || (idx-1)::text AS metric, c / 100.0 AS value FROM (SELECT time, agent_id, unnest(cpu_cores_bp) AS c, generate_subscripts(cpu_cores_bp, 1) AS idx FROM metrics WHERE agent_id ~ '${agent:regex}' AND $__timeFilter(time)) t ORDER BY time",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "gradientMode": "opacity", "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*total.*" }, "properties": [{ "id": "custom.lineWidth", "value": 3 }, { "id": "custom.fillOpacity", "value": 25 }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 121,
      "type": "timeseries",
      "title": "Interfaces de Rede (rx / tx)",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT time, agent_id || '/' || interface || ' rx' AS metric, rx_bytes AS value FROM net_metrics WHERE agent_id ~ '${agent:regex}' AND $__timeFilter(time) AND interface NOT IN ('lo','docker0') ORDER BY time",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT time, agent_id || '/' || interface || ' tx' AS metric, -tx_bytes AS value FROM net_metrics WHERE agent_id ~ '${agent:regex}' AND $__timeFilter(time) AND interface NOT IN ('lo','docker0') ORDER BY time",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "gradientMode": "opacity", "spanNulls": true, "axisCenteredZero": true }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 130,
      "type": "timeseries",
      "title": "Uso de Memória",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT time, agent_id || ' used' AS metric, mem_used AS value FROM metrics WHERE agent_id ~ '${agent:regex}' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT time, agent_id || ' available' AS metric, mem_available AS value FROM metrics WHERE agent_id ~ '${agent:regex}' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT time, agent_id || ' swap_used' AS metric, swap_used AS value FROM metrics WHERE agent_id ~ '${agent:regex}' AND $__timeFilter(time) ORDER BY time",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 25, "gradientMode": "opacity", "stacking": { "mode": "none" }, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*used$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*available$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*swap_used$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 131,
      "type": "timeseries",
      "title": "Memória por container (%)",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT c.time, c.container_name AS metric, (c.mem_usage::float / NULLIF(COALESCE(NULLIF(c.mem_limit,0), m.mem_total), 0) * 100) AS value FROM container_metrics c LEFT JOIN LATERAL (SELECT mem_total FROM metrics WHERE agent_id = c.agent_id ORDER BY time DESC LIMIT 1) m ON true WHERE c.agent_id ~ '${agent:regex}' AND $__timeFilter(c.time) ORDER BY c.time",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15, "spanNulls": true }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 132,
      "type": "table",
      "title": "Containers (uso atual)",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT DISTINCT ON (c.container_id) c.container_name AS name, c.image, c.state, c.cpu_bp / 100.0 AS \"cpu_%\", c.mem_usage AS mem_used, COALESCE(NULLIF(c.mem_limit,0), m.mem_total) AS mem_limit, (c.mem_usage::float / NULLIF(COALESCE(NULLIF(c.mem_limit,0), m.mem_total),0) * 100) AS \"mem_%\" FROM container_metrics c LEFT JOIN LATERAL (SELECT mem_total FROM metrics WHERE agent_id = c.agent_id ORDER BY time DESC LIMIT 1) m ON true WHERE c.agent_id ~ '${agent:regex}' AND c.time > NOW() - INTERVAL '2 minutes' ORDER BY c.container_id, c.time DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cpu_%" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "#EAB839", "value": 70 }, { "color": "red", "value": 90 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "mem_%" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "#EAB839", "value": 70 }, { "color": "red", "value": 90 }] } }
            ]
          },
          { "matcher": { "id": "byName", "options": "mem_used" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "mem_limit" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          {
            "matcher": { "id": "byName", "options": "state" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [{ "type": "value", "options": { "running": { "color": "green", "index": 0 }, "exited": { "color": "red", "index": 1 }, "paused": { "color": "orange", "index": 2 } } }] }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } }
    },

