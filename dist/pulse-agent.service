[Unit]
Description=Vixpi Pulse Agent
Documentation=https://github.com/gcnsolucoes/vixpi-pulse
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pulse-agent /etc/pulse-agent.toml
Restart=always
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
ReadWritePaths=/etc/pulse
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
